{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AcmeDnsChallengeCleanup",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "AcmeDnsChallengeRecords",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/Z09654461UHZKWUZUMQEK"
    },
    {
      "Sid": "AcmeDnsZoneLookup",
      "Effect": "Allow",
      "Action": "route53:ListHostedZonesByName",
      "Resource": "*"
    }
  ]
}
